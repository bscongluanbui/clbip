# Copy only for a NEW deployment if you want to preconfigure Compose.
# Existing deployment: keep .env; do not overwrite secrets or installer state.
# Installer can create .env itself. Never put passwords/tokens/secret keys here.

# Published registry image; use a real published tag/digest to pin a release.
IPV6_MANAGER_IMAGE=ghcr.io/bscongluanbui/clbip:latest

# Loopback by default. Opt in to all IPv4 interfaces with:
# sudo bash scripts/install.sh --bind 0.0.0.0 --port 7070
# GUI_BIND=0.0.0.0
# Then open http://192.168.1.3:7070 when that is the server LAN IP.
GUI_BIND=127.0.0.1
GUI_PORT=7070

# Worker task/thread ceiling; host controller persists changes to this value.
WORKER_THREAD_LIMIT=4096

# Optional integrations. Configure Telegram token/chat ID in the dashboard.
TELEGRAM_ENABLED=0
TELEGRAM_ALLOWED_USER_IDS=
DNS_CACHE_ENABLED=0

# Set 1 only when dashboard clients use HTTPS.
SESSION_COOKIE_SECURE=0

# Leave unset for normal registry mode. Installer --build writes both lines:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml
# IPV6_MANAGER_IMAGE=ipv6-proxy-manager:local
# Keep COMPOSE_FILE after building so plain docker compose uses the same mode.
# Return to registry: COMPOSE_FILE=docker-compose.yml and a published image ref.
# COMPOSE_FILE uses ':' as the Linux file separator.
